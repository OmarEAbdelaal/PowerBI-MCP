# --- Authentication (choose one mode) ---
POWERBI_AUTH_MODE=service_principal   # service_principal | device_code | access_token
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=                # service_principal only
# POWERBI_ACCESS_TOKEN=               # access_token mode only

# --- Behaviour ---
POWERBI_DEFAULT_WORKSPACE_ID=
POWERBI_READ_ONLY=false
POWERBI_ENABLE_ADMIN_TOOLS=false
POWERBI_MAX_ROWS=1000
# POWERBI_EXPORT_DIR=./powerbi_exports
